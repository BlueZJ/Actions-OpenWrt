# ============================================================
# R3S 精简优化片段：无 SQM / PPPoE / UPnP，保留 eBPF + 全量 kmod
# 用法：cat 本片段 >> .config && make defconfig（后写的生效）
# ============================================================

# ---- 1. Target / 设备（注意是连字符 nanopi-r3s）----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r3s=y

# ---- 2. 板载硬件：必须 =y（=m 只编不装，就是上次 LAN 灯黑的原因）----
CONFIG_PACKAGE_kmod-r8169=y                 # LAN = eth1 = PCIe RTL8168h
CONFIG_PACKAGE_r8169-firmware=y             # rtl8168h-2.fw
CONFIG_PACKAGE_kmod-phy-realtek=y           # WAN = eth0 = GMAC + RTL8211F

# ---- 3. 签名 / 包管理（APK）----
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y

# ---- 4. 构建选项：关掉发布级 / 耗时占盘项 ----
CONFIG_DEVEL=y
# CONFIG_BUILDBOT is not set                # 关掉后 base-files 自动装签名公钥
# CONFIG_IB is not set
# CONFIG_IB_STANDALONE is not set
# CONFIG_SDK is not set
# CONFIG_MAKE_TOOLCHAIN is not set
# CONFIG_GDB is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set    # 不影响 BTF
# CONFIG_JSON_CYCLONEDX_SBOM is not set
# CONFIG_CCACHE is not set                  # 一次性 runner 无命中收益
CONFIG_AUTOREMOVE=y                         # 编完删 build_dir，省磁盘
CONFIG_ALL_KMODS=y                          # 保留：以后可直接 apk add 任意 kmod
# CONFIG_ALL is not set
# CONFIG_ALL_NONSHARED is not set

# ---- 5. 内核：BTF / eBPF / 可排错 ----
CONFIG_DWARVES=y                            # pahole，BTF 必需
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y   # 关键：避免模块因 BTF 校验被拒绝加载
CONFIG_KERNEL_KALLSYMS=y
# CONFIG_KERNEL_WERROR is not set
CONFIG_KERNEL_CFLAGS=""                     # 清掉 -mcpu/-mtune，与官方一致
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_PERF_EVENTS=y

# ---- 6. 防火墙 / NAT / 加速（没有 SQM，可放心用 offload 跑满千兆）----
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
# CONFIG_PACKAGE_nftables-nojson is not set
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---- 7. DNS / DHCP / IPv6（同包变体，二选一）----
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_odhcpd is not set
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y

# ---- 8. LuCI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
# 中文界面（不需要可删这 3 行）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y

# ---- 9. 常用工具 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y                    # 支持 ip link ... xdp 挂载
# CONFIG_PACKAGE_ip-tiny is not set

# ---- 10. eBPF 用户态（tc 只留 BPF 版，不再需要 tc-full）----
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_bpftool-full=y
# CONFIG_PACKAGE_bpftool-minimal is not set
CONFIG_PACKAGE_tc-bpf=y
# CONFIG_PACKAGE_tc-tiny is not set
# CONFIG_PACKAGE_tc-full is not set
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y

# ---- 11. 明确关掉：SQM / PPPoE / UPnP ----
# SQM / QoS 整形
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_qos-scripts is not set
# CONFIG_PACKAGE_qosify is not set
# CONFIG_PACKAGE_kmod-sched-cake is not set
# CONFIG_PACKAGE_kmod-ifb is not set
# CONFIG_PACKAGE_kmod-sched-ctinfo is not set
# CONFIG_PACKAGE_kmod-netem is not set
# PPP / PPPoE
# CONFIG_PACKAGE_luci-proto-ppp is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_kmod-pppox is not set
# CONFIG_PACKAGE_kmod-slhc is not set
# UPnP / NAT-PMP
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set
# CONFIG_PACKAGE_libminiupnpc is not set
# CONFIG_PACKAGE_libnatpmp is not set

# ---- 12. 固件格式：只留 squashfs（避免 Artifact 里两套镜像刷错）----
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=256

# ---- 13. 可选：RK3566(Cortex-A55) 用户态优化，保守起见默认关闭 ----
# CONFIG_TARGET_OPTIONS=y
# CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a55"

# ---- 14. LuCI 中文界面（总开关必须先开！）----
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
